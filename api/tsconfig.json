{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": [
    "./**/*.ts",
    "../server/**/*.ts",
    "../src/lib/domain.ts",
    "../src/lib/format.ts",
    "../src/types.ts"
  ]
}
