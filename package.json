{
  "name": "rheomiq",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "predev:web": "node scripts/sync-ocr-assets.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "prebuild": "node scripts/sync-ocr-assets.mjs",
    "build": "tsc -b && vite build && node scripts/bundle-budget.mjs",
    "start": "tsx server/index.ts --serve-dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "security:guard": "node scripts/security-guard.mjs",
    "qa:ux": "node scripts/ui-ux-hardening-qa.mjs",
    "qa:visual": "node scripts/ui-ux-visual-evidence-qa.mjs",
    "qa:frontend": "node scripts/run-rendered-qa.mjs",
    "check": "npm run security:guard && npm run test && npm run build",
    "desktop:dev": "npm --prefix desktop run dev",
    "desktop:check": "npm --prefix desktop run check",
    "desktop:pack": "npm run build && npm --prefix desktop run pack",
    "desktop:dist": "npm run build && npm --prefix desktop run dist",
    "db:import": "tsx scripts/migrate-json-to-supabase.ts",
    "db:verify": "tsx scripts/migrate-json-to-supabase.ts --verify-only",
    "hygiene:cycles": "node scripts/dependency-cycles.mjs",
    "hygiene:unused": "node scripts/unused-symbols.mjs",
    "hygiene:exports": "node scripts/unused-exports.mjs",
    "hygiene:format": "node scripts/format-hygiene.mjs",
    "hygiene": "npm run hygiene:cycles && npm run hygiene:unused && npm run hygiene:exports && npm run hygiene:format && node scripts/final-screenshots-qa.mjs --validate-only",
    "qa:final-screenshots": "node scripts/final-screenshots-qa.mjs",
    "desktop:audit": "npm --prefix desktop run audit",
    "desktop:check:source": "npm --prefix desktop run check:source",
    "desktop:pack:from-dist": "npm --prefix desktop run pack",
    "desktop:dist:from-dist": "npm --prefix desktop run dist"
  },
  "dependencies": {
    "@tesseract.js-data/ell": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "express": "^5.2.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.10"
  }
}
