{
  "name": "rheomiq",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts --serve-dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "security:guard": "node scripts/security-guard.mjs",
    "qa:frontend": "node scripts/frontend-qa.mjs && node scripts/frontend-redesign-qa.mjs",
    "check": "npm run security:guard && npm run test && npm run build",
    "db:import": "tsx scripts/migrate-json-to-supabase.ts",
    "db:verify": "tsx scripts/migrate-json-to-supabase.ts --verify-only"
  },
  "dependencies": {
    "express": "^5.2.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
