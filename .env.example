RHEOMIQ_PORT=4317
RHEOMIQ_HOST=127.0.0.1
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Safe to use server-side for Auth/Data API requests scoped by the user's JWT.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# LOCAL/DESKTOP PAN + expiry vault only. Never expose as VITE_* and never commit
# the real value. Use exactly 64 hex characters or Base64 that decodes to 32 bytes.
# The Windows installer imports this once into Electron safeStorage/Windows DPAPI.
CARD_VAULT_KEY=REPLACE_WITH_64_HEX_OR_32_BYTE_BASE64
CARD_VAULT_KEY_VERSION=1

# OFFLINE EMERGENCY TOOLING ONLY (db:import / db:verify).
# Never configure this in Vercel and never expose it as VITE_*.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Optional one-time local import source. This file remains git-ignored.
RHEOMIQ_IMPORT_FILE=./data/rheomiq-data.json
