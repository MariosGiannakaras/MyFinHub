RHEOMIQ_PORT=4317
RHEOMIQ_HOST=127.0.0.1
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Safe to use server-side for Auth/Data API requests scoped by the user's JWT.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# OFFLINE EMERGENCY TOOLING ONLY (db:import / db:verify).
# Never configure this in Vercel and never expose it as VITE_*.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Optional one-time local import source. This file remains git-ignored.
RHEOMIQ_IMPORT_FILE=./data/rheomiq-data.json
